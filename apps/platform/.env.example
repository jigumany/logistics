APP_NAME="Logistics Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=logistics
DB_USERNAME=logistics
DB_PASSWORD=local-development-only
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=local-storage
AWS_SECRET_ACCESS_KEY=local-storage-password
AWS_DEFAULT_REGION=af-south-1
AWS_BUCKET=logistics
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
MAIL_MAILER=log
DEMO_PASSWORD=

GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BILLING_CONFIRMED=false
GOOGLE_MAPS_RETENTION_PERMITTED=false
GOOGLE_MAPS_RETENTION_HOURS=0
GOOGLE_MAPS_TIMEOUT_SECONDS=4
