{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuotationContract",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "QuoteAddress": {
      "type": "object",
      "properties": {
        "address_line": {
          "type": "string"
        },
        "suburb": {
          "type": ["string", "null"]
        },
        "city": {
          "type": "string"
        },
        "postal_code": {
          "type": ["string", "null"]
        },
        "country_code": {
          "type": "string"
        },
        "latitude": {
          "type": ["number", "string", "null"]
        },
        "longitude": {
          "type": ["number", "string", "null"]
        },
        "provider_place_id": {
          "type": ["string", "null"]
        },
        "verification_proof": {
          "type": ["string", "null"]
        },
        "instructions": {
          "type": ["string", "null"]
        }
      },
      "required": ["address_line", "city", "country_code"],
      "additionalProperties": false
    },
    "InventoryEntry": {
      "type": "object",
      "properties": {
        "item_key": {
          "type": "string"
        },
        "catalogue_public_id": {
          "type": ["string", "null"]
        },
        "name": {
          "type": ["string", "null"]
        },
        "quantity": {
          "type": "integer"
        },
        "length_cm": {
          "type": ["string", "null"]
        },
        "width_cm": {
          "type": ["string", "null"]
        },
        "height_cm": {
          "type": ["string", "null"]
        },
        "weight_kg": {
          "type": ["string", "null"]
        },
        "fragile": {
          "type": "boolean"
        },
        "oversized": {
          "type": "boolean"
        },
        "stackable": {
          "type": "boolean"
        },
        "rotation_allowed": {
          "type": "boolean"
        },
        "instructions": {
          "type": ["string", "null"]
        },
        "weight_certainty": {
          "enum": ["known", "estimated", "unknown"]
        }
      },
      "required": [
        "item_key",
        "quantity",
        "fragile",
        "oversized",
        "stackable",
        "rotation_allowed"
      ],
      "additionalProperties": false
    },
    "MoveDetails": {
      "type": "object",
      "properties": {
        "pickup_stairs": {
          "type": "integer"
        },
        "delivery_stairs": {
          "type": "integer"
        },
        "pickup_lift": {
          "type": "boolean"
        },
        "delivery_lift": {
          "type": "boolean"
        },
        "pickup_carry_metres": {
          "type": "integer"
        },
        "delivery_carry_metres": {
          "type": "integer"
        },
        "parking_limited": {
          "type": "boolean"
        },
        "difficult_access": {
          "type": "boolean"
        },
        "special_equipment": {
          "type": "boolean"
        },
        "packing": {
          "type": "boolean"
        },
        "waiting_minutes": {
          "type": "integer"
        },
        "declared_goods_value_minor": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100000000000
        },
        "declared_goods_currency": {
          "type": ["string", "null"],
          "enum": ["ZAR", "USD", "EUR", "GBP", null]
        }
      },
      "required": [
        "pickup_stairs",
        "delivery_stairs",
        "pickup_lift",
        "delivery_lift",
        "pickup_carry_metres",
        "delivery_carry_metres",
        "parking_limited",
        "difficult_access",
        "special_equipment",
        "packing",
        "waiting_minutes"
      ],
      "additionalProperties": false
    },
    "QuoteInput": {
      "type": "object",
      "properties": {
        "service_public_id": {
          "type": "string"
        },
        "preferred_date": {
          "type": "string"
        },
        "preferred_time": {
          "type": ["string", "null"]
        },
        "stops": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "$ref": "#/definitions/QuoteAddress"
          }
        },
        "inventory": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/InventoryEntry"
          }
        },
        "details": {
          "$ref": "#/definitions/MoveDetails"
        }
      },
      "required": [
        "service_public_id",
        "preferred_date",
        "stops",
        "inventory",
        "details"
      ],
      "additionalProperties": false
    },
    "QuoteContact": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": ["string", "null"]
        },
        "consent": {
          "type": "boolean"
        },
        "communication": {
          "enum": ["email", "none"]
        },
        "marketing_consent": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "email",
        "consent",
        "communication",
        "marketing_consent"
      ],
      "additionalProperties": false
    },
    "QuoteLine": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "quantity": {
          "type": ["string", "number"]
        },
        "rate_micros": {
          "type": "integer"
        },
        "amount_minor": {
          "type": "integer"
        },
        "rate_display": {
          "type": "string"
        },
        "quantity_unit": {
          "type": "string"
        },
        "rate_kind": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "description",
        "stage",
        "quantity",
        "rate_micros",
        "amount_minor",
        "rate_display",
        "quantity_unit",
        "rate_kind"
      ],
      "additionalProperties": false
    },
    "QuoteInventoryRow": {
      "type": "object",
      "properties": {
        "public_id": {
          "type": "string"
        },
        "item_key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "quantity": {
          "type": "integer"
        },
        "length_cm": {
          "type": ["string", "null"]
        },
        "width_cm": {
          "type": ["string", "null"]
        },
        "height_cm": {
          "type": ["string", "null"]
        },
        "weight_kg": {
          "type": ["string", "null"]
        },
        "volume_m3": {
          "type": ["string", "null"]
        },
        "measurement_source": {
          "enum": ["catalogue", "customer", "measured", "unknown"]
        },
        "fragile": {
          "type": "boolean"
        },
        "oversized": {
          "type": "boolean"
        },
        "stackable": {
          "type": "boolean"
        },
        "rotation_allowed": {
          "type": "boolean"
        },
        "instructions": {
          "type": ["string", "null"]
        },
        "photos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "public_id",
        "item_key",
        "name",
        "quantity",
        "length_cm",
        "width_cm",
        "height_cm",
        "weight_kg",
        "volume_m3",
        "measurement_source",
        "fragile",
        "oversized",
        "stackable",
        "rotation_allowed",
        "instructions",
        "photos"
      ],
      "additionalProperties": true
    },
    "InventorySummary": {
      "type": "object",
      "properties": {
        "quantity": {
          "type": "integer"
        },
        "volume_m3": {
          "type": "string"
        },
        "total_weight_kg": {
          "type": ["string", "null"]
        },
        "known_weight_kg": {
          "type": "string"
        },
        "unknown_weight_quantity": {
          "type": "integer"
        },
        "unknown_volume_quantity": {
          "type": "integer"
        },
        "safety_margin_bps": {
          "type": "integer"
        },
        "loading_complexity": {
          "type": "integer"
        }
      },
      "required": [
        "quantity",
        "volume_m3",
        "total_weight_kg",
        "known_weight_kg",
        "unknown_weight_quantity",
        "unknown_volume_quantity",
        "safety_margin_bps",
        "loading_complexity"
      ],
      "additionalProperties": true
    },
    "QuoteRevisionData": {
      "type": "object",
      "properties": {
        "public_id": {
          "type": "string"
        },
        "number": {
          "type": "integer"
        },
        "approval": {
          "enum": ["automatic", "pending", "approved"]
        },
        "currency": {
          "type": ["string", "null"]
        },
        "subtotal_minor": {
          "type": ["integer", "null"]
        },
        "tax_minor": {
          "type": ["integer", "null"]
        },
        "total_minor": {
          "type": ["integer", "null"]
        },
        "terms": {
          "type": "string"
        },
        "exclusions": {
          "type": "string"
        },
        "expires_at": {
          "type": "string"
        },
        "expired": {
          "type": "boolean"
        },
        "contact_snapshot": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "phone": {
              "type": ["string", "null"]
            },
            "communication": {
              "enum": ["email", "none"]
            }
          },
          "required": [],
          "additionalProperties": true
        },
        "inventory_summary": {
          "$ref": "#/definitions/InventorySummary"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/QuoteLine"
          }
        },
        "inventory": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/QuoteInventoryRow"
          }
        },
        "stops": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "address_line": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "postal_code": {
                "type": ["string", "null"]
              },
              "kind": {
                "type": "string"
              },
              "position": {
                "type": "integer"
              },
              "instructions": {
                "type": ["string", "null"]
              },
              "verification": {
                "type": "string"
              }
            },
            "required": ["address_line", "city", "kind", "position"],
            "additionalProperties": true
          }
        },
        "review_reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "customer_message": {
                "type": "string"
              }
            },
            "required": ["code", "customer_message"],
            "additionalProperties": true
          }
        },
        "pricing_method": {
          "type": "string"
        },
        "service_name": {
          "type": "string"
        },
        "move_details": {
          "$ref": "#/definitions/MoveDetails"
        },
        "preferred_time": {
          "type": ["string", "null"]
        },
        "terms_version": {
          "type": "string"
        }
      },
      "required": [
        "public_id",
        "number",
        "approval",
        "currency",
        "subtotal_minor",
        "tax_minor",
        "total_minor",
        "terms",
        "exclusions",
        "expires_at",
        "expired",
        "contact_snapshot",
        "inventory_summary",
        "lines",
        "inventory",
        "stops",
        "review_reasons",
        "pricing_method",
        "service_name",
        "move_details",
        "preferred_time"
      ],
      "additionalProperties": true
    },
    "QuotationData": {
      "type": "object",
      "properties": {
        "public_id": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "calculating",
            "requires_review",
            "quoted",
            "accepted",
            "expired",
            "declined",
            "cancelled"
          ]
        },
        "lock_version": {
          "type": "integer"
        },
        "preferred_date": {
          "type": ["string", "null"]
        },
        "submitted_at": {
          "type": ["string", "null"]
        },
        "accepted_at": {
          "type": ["string", "null"]
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "#/definitions/QuoteRevisionData"
            },
            {
              "type": "null"
            }
          ]
        },
        "links": {
          "type": "object",
          "properties": {
            "view": {
              "type": "string"
            },
            "calculate": {
              "type": "string"
            },
            "submit": {
              "type": "string"
            },
            "accept": {
              "type": "string"
            },
            "respond": {
              "type": "string"
            },
            "photo": {
              "type": "string"
            },
            "pdf": {
              "type": "string"
            },
            "revisions": {
              "type": "string"
            },
            "save": {
              "type": "string"
            },
            "decline": {
              "type": "string"
            },
            "cancel": {
              "type": "string"
            },
            "booking": {
              "type": "string"
            }
          },
          "required": [
            "view",
            "calculate",
            "submit",
            "accept",
            "respond",
            "photo",
            "pdf",
            "revisions",
            "save",
            "decline",
            "cancel"
          ],
          "additionalProperties": false
        },
        "booking_confirmed": {
          "type": "boolean"
        },
        "information_request": {
          "type": ["string", "null"]
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "public_id": {
                "type": "string"
              },
              "item_key": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": ["public_id", "item_key", "url"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "public_id",
        "reference",
        "status",
        "lock_version",
        "preferred_date",
        "submitted_at",
        "accepted_at",
        "revision",
        "links",
        "booking_confirmed",
        "information_request",
        "attachments"
      ],
      "additionalProperties": true
    }
  }
}
